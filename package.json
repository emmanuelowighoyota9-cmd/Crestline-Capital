    "bcryptjs": "^2.4.3",
    "jose": "^5.2.0",
    "uuid": "^9.0.0",
    "lucide-react": "^0.378.0",
    "recharts": "^2.12.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.3.0",
    "class-variance-authority": "^0.7.0"
  },
  "devDependencies": {
    "prisma": "^5.14.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/uuid": "^9.0.0",
    "typescript": "^5.4.0",
    "tailwindcss": "^3.4.0",
