{
  "name": "crestline-capital",
  "version": "1.0.0",
  "private": true,
  "description": "Crestline Capital — Digital wealth management platform",
  "scripts": {
    "dev": "next dev",
    "build": "./node_modules/.bin/prisma generate && ./node_modules/.bin/prisma db push && ./node_modules/.bin/tsx prisma/seed.ts && next build",
